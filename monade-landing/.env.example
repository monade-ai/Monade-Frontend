# Copy to .env.local (Vercel: add these in Project Settings > Environment Variables)

# Booking link opened after a visitor submits their email (Cal.com / Calendly). Optional.
NEXT_PUBLIC_BOOKING_URL=

# Monade outbound call API for the "Talk to our AI" widget. Leave blank to simulate.
# The route POSTs the dashboard's own test-call shape:
#   { phone_number, assistant_id, trunk_name, user_uid, callee_info }
# MONADE_CALL_API_URL: the outbound-call endpoint (a literal {phone} in the URL is replaced
#   with the E.164 number, for the /voice_agents/outbound-call/{phone} style).
# MONADE_CALL_API_KEY: key from Settings > API & Integrations > Generate new.
# MONADE_CALL_API_KEY_HEADER: header that carries the key (default x-api-key; "Authorization" sends Bearer).
MONADE_CALL_API_URL=
MONADE_CALL_API_KEY=
MONADE_CALL_API_KEY_HEADER=x-api-key
MONADE_DEMO_AGENT_ID=
MONADE_TRUNK_NAME=
MONADE_USER_UID=

# Supabase (service role, server-side only) to store website leads. Optional.
# Table: website_leads (kind text, phone text, email text, ip text, user_agent text, referer text, created_at timestamptz default now())
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Used only by scripts/gen-copy.ps1 (not by the site)
GEMINI_API_KEY=
